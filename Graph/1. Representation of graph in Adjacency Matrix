import java.util.*;

public class Main {

    static class Graph {
        int[][] adj;
        int vertices;

        // Constructor
        Graph(int n) {
            vertices = n;
            adj = new int[n][n];
        }

        // Add an edge between u and v
        void addEdge(int u, int v) {
            if (u < 0 || v < 0 || u >= vertices || v >= vertices) {
                System.out.println("Invalid vertex");
                return;
            }

            adj[u][v] = 1;
            adj[v][u] = 1;   // Undirected graph
        }

        // Delete an edge between u and v
        void deleteEdge(int u, int v) {
            if (u < 0 || v < 0 || u >= vertices || v >= vertices) {
                System.out.println("Invalid vertex");
                return;
            }

            adj[u][v] = 0;
            adj[v][u] = 0;
        }

        // Check whether edge exists
        boolean hasEdge(int u, int v) {
            if (u < 0 || v < 0 || u >= vertices || v >= vertices) {
                return false;
            }

            return adj[u][v] == 1;
        }

        // Add a new vertex
        void addVertex() {

            int[][] newAdj = new int[vertices + 1][vertices + 1];

            // Copy old matrix
            for (int i = 0; i < vertices; i++) {
                for (int j = 0; j < vertices; j++) {
                    newAdj[i][j] = adj[i][j];
                }
            }

            adj = newAdj;
            vertices++;
        }

        // Delete a vertex
        void deleteVertex(int vertex) {

            if (vertex < 0 || vertex >= vertices) {
                System.out.println("Invalid vertex");
                return;
            }

            int[][] newAdj = new int[vertices - 1][vertices - 1];

            int newRow = 0;

            for (int i = 0; i < vertices; i++) {

                if (i == vertex)
                    continue;

                int newCol = 0;

                for (int j = 0; j < vertices; j++) {

                    if (j == vertex)
                        continue;

                    newAdj[newRow][newCol] = adj[i][j];
                    newCol++;
                }

                newRow++;
            }

            adj = newAdj;
            vertices--;
        }

        // Display adjacency matrix
        void display() {

            System.out.println("Adjacency Matrix:");

            for (int i = 0; i < vertices; i++) {
                for (int j = 0; j < vertices; j++) {
                    System.out.print(adj[i][j] + " ");
                }
                System.out.println();
            }
        }
    }

    public static void main(String[] args) {

        Graph g = new Graph(4);

        // Add edges
        g.addEdge(0, 1);
        g.addEdge(0, 2);
        g.addEdge(1, 2);
        g.addEdge(2, 3);

        g.display();

        System.out.println();

        // Check edge
        System.out.println("Edge 0-1: " + g.hasEdge(0, 1));

        // Delete edge
        g.deleteEdge(0, 1);

        System.out.println();
        System.out.println("After deleting edge 0-1:");
        g.display();

        // Add vertex
        g.addVertex();

        // Connect new vertex 4
        g.addEdge(4, 2);

        System.out.println();
        System.out.println("After adding vertex 4:");
        g.display();

        // Delete vertex
        g.deleteVertex(1);

        System.out.println();
        System.out.println("After deleting vertex 1:");
        g.display();
    }
}