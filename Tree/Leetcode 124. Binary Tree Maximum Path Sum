/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
/**
 * Problem: LeetCode 124. Binary Tree Maximum Path Sum
 * 
 * Approach:
 * - A path can start and end at any node in the tree.
 * - We use a recursive post-order traversal to calculate the maximum path sum originating from the current node's left and right subtrees.
 * - If a subtree's path sum is negative, we ignore it (take 0 instead) because adding a negative sum would only decrease our overall path sum.
 * - At each node, we calculate the `currentPath` sum which is `root.val + left + right`. We update our global `maxSum` if `currentPath` is greater.
 * - The recursive function must return the maximum path sum of one of its branches (either left or right) plus its own value to its parent node.
 * 
 * Complexity:
 * - Time Complexity: O(N), where N is the number of nodes. We visit each node exactly once.
 * - Space Complexity: O(H), where H is the height of the tree, used by the recursion stack.
 */
class Solution {

    int maxSum = Integer.MIN_VALUE;

    public int maxPathSum(TreeNode root) {
        findMax(root);
        return maxSum;
    }

    public int findMax(TreeNode root) {

        if (root == null) {
            return 0;
        }

       
        int left = Math.max(0, findMax(root.left));
        int right = Math.max(0, findMax(root.right));

        
        int currentPath = root.val + left + right;

        
        maxSum = Math.max(maxSum, currentPath);

       
        return root.val + Math.max(left, right);
    }
}
