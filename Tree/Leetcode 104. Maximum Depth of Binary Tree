/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
/**
 * Problem: LeetCode 104. Maximum Depth of Binary Tree
 * 
 * Approach:
 * - The maximum depth of a binary tree can be found recursively.
 * - The depth of an empty tree is 0.
 * - For a non-empty tree, the maximum depth is 1 plus the maximum of the depths of its left and right subtrees.
 * - This uses a standard post-order traversal (process children before the root).
 * 
 * Complexity:
 * - Time Complexity: O(N), where N is the number of nodes in the binary tree. We visit each node exactly once.
 * - Space Complexity: O(H), where H is the height of the tree. This is the space required for the call stack during recursion. In the worst case (skewed tree), it's O(N).
 */
class Solution {
    public int maxDepth(TreeNode root) {

        if(root == null){
            return  0 ;
        }
        
        int left = maxDepth( root.left);
        int right = maxDepth( root.right);

        int h = Math.max(left , right ) +1 ;

        return h;
    }
}
