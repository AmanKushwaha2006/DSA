import java.util.*;

/**
 * Problem: LeetCode 1386. Cinema Seat Allocation
 * 
 * Approach:
 * - We can allocate at most 2 families per row (if no seats are reserved in the middle blocks).
 * - Since the number of rows 'n' can be very large (up to 10^9), we only keep track of rows that have reserved seats using a HashMap.
 * - Each row starts with a potential 2 families. We deduct families based on reserved seats.
 * - A family can sit in the left block (cols 2,3,4,5), the right block (cols 6,7,8,9), or the middle block (cols 4,5,6,7).
 * - For each row in the map, we check these conditions to see how many families can fit (0, 1, or 2).
 * - Rows not in the map will contribute 2 families each.
 * 
 * Complexity:
 * - Time Complexity: O(R), where R is the number of reserved seats. Iterating over the map takes time proportional to the unique reserved rows.
 * - Space Complexity: O(R) to store the reserved seats in the HashMap.
 */
class Solution {
    public int maxNumberOfFamilies(int n, int[][] reservedSeats) {
        
        HashMap<Integer, boolean[]> map = new HashMap<>();

        for (int[] seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];

            if (!map.containsKey(row)) {
                map.put(row, new boolean[11]);
            }

            map.get(row)[col] = true;
        }

        int ans = (n - map.size()) * 2;

        for (int row : map.keySet()) {
            boolean[] seats = map.get(row);

            boolean left = true;
            boolean right = true;

            for (int i = 2; i <= 5; i++) {
                if (seats[i]) {
                    left = false;
                    break;
                }
            }

            for (int i = 6; i <= 9; i++) {
                if (seats[i]) {
                    right = false;
                    break;
                }
            }

            if (left && right) {
                ans += 2;
            } else if (left || right) {
                ans += 1;
            } else {
                boolean middle = true;

                for (int i = 4; i <= 7; i++) {
                    if (seats[i]) {
                        middle = false;
                        break;
                    }
                }

                if (middle) {
                    ans += 1;
                }
            }
        }

        return ans;
    }
}
