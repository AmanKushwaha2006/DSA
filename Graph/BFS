/**
 * Problem: Breadth First Search (BFS) Traversal of a Graph
 * 
 * Approach:
 * - Use a Queue to keep track of nodes to be visited.
 * - Use a boolean visited array to ensure no node is processed more than once.
 * - Start with the initial node (usually 0), mark it as visited, and push it into the queue.
 * - While the queue is not empty, pop the front node, add it to the answer list, and push all its unvisited neighbors into the queue, marking them as visited.
 * 
 * Complexity:
 * - Time Complexity: O(V + E), where V is the number of vertices and E is the number of edges. Each vertex and edge is processed at most once.
 * - Space Complexity: O(V), where V is the number of vertices, used by the queue and the visited array.
 */
class Solution {
    public ArrayList<Integer> bfs(ArrayList<ArrayList<Integer>> adj) {

        ArrayList<Integer> ans = new ArrayList<>();
        int V = adj.size();

        boolean[] visited = new boolean[V];
        Queue<Integer> q = new LinkedList<>();

        // Start BFS from node 0
        visited[0] = true;
        q.add(0);

        while (!q.isEmpty()) {

            int node = q.poll();
            ans.add(node);

            for (int neighbor : adj.get(node)) {

                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    q.add(neighbor);
                }
            }
        }

        return ans;
    }
}
