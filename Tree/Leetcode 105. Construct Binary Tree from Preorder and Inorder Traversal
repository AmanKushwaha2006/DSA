import java.util.*;

/**
 * Problem: LeetCode 105. Construct Binary Tree from Preorder and Inorder Traversal
 * 
 * Approach:
 * - The first element in the 'preorder' traversal is always the root of the current subtree.
 * - We can find this root element in the 'inorder' traversal. Elements to its left form the left subtree, and elements to its right form the right subtree.
 * - To optimize finding the root in the inorder array, we store the values and their indices in a HashMap.
 * - We recursively build the left and right subtrees by passing the appropriate bounds (left, right) for the inorder array and advancing the root index for the preorder array.
 * 
 * Complexity:
 * - Time Complexity: O(N), where N is the number of nodes. Building the HashMap takes O(N), and the recursive construction visits each node once.
 * - Space Complexity: O(N) to store the HashMap. The recursion stack also takes O(H) space, where H is the height of the tree.
 */
class Solution {

    public TreeNode buildTree(int[] preorder, int[] inorder) {

        Map<Integer, Integer> inorderMap = new HashMap<>();

        for (int i = 0; i < inorder.length; i++) {
            inorderMap.put(inorder[i], i);
        }

        return build(preorder, inorderMap, 0, 0, inorder.length - 1);
    }

    private TreeNode build(int[] preorder, Map<Integer, Integer> inorderMap,
                           int rootIndex, int left, int right) {

        if (left > right) {
            return null;
        }

        TreeNode root = new TreeNode(preorder[rootIndex]);

        int mid = inorderMap.get(preorder[rootIndex]);

        root.left = build(preorder, inorderMap,
                rootIndex + 1,
                left,
                mid - 1);

        root.right = build(preorder, inorderMap,
                rootIndex + (mid - left) + 1,
                mid + 1,
                right);

        return root;
    }
}
