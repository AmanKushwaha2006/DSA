class Solution {

    public TreeNode buildTree(int[] preorder, int[] inorder) {

        Map<Integer, Integer> inorderMap = new HashMap<>();

        for (int i = 0; i < inorder.length; i++) {
            inorderMap.put(inorder[i], i);
        }

        return build(preorder, inorderMap, 0, 0, inorder.length - 1);
    }

    private TreeNode build(int[] preorder, Map<Integer, Integer> inorderMap,
                           int rootIndex, int left, int right) {

        if (left > right) {
            return null;
        }

        TreeNode root = new TreeNode(preorder[rootIndex]);

        int mid = inorderMap.get(preorder[rootIndex]);

        root.left = build(preorder, inorderMap,
                rootIndex + 1,
                left,
                mid - 1);

        root.right = build(preorder, inorderMap,
                rootIndex + (mid - left) + 1,
                mid + 1,
                right);

        return root;
    }
}
